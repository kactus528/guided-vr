{
  "name": "guided-vr-reprocessing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build:docs": "esbuild src/main.ts --bundle --format=esm --target=es2022 --external:three --define:import.meta.env.PROD=true --minify --sourcemap --outfile=docs/app.js"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
